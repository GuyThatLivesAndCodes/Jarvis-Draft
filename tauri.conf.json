{
  "build": {
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "distDir": "./dist"
  },
  "package": {
    "productName": "Jarvis",
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "identifier": "io.jarvis.app",
      "icon": [
        "icons/icon.png",
        "icons/icon.ico"
      ]
    },
    "allowlist": {
      "all": true,
      "shell": {
        "all": true,
        "execute": true,
        "open": true
      },
      "window": {
        "all": true
      },
      "fs": {
        "all": true,
        "readFile": true,
        "writeFile": true,
        "createDir": true,
        "removeDir": true,
        "removeFile": true,
        "copyFile": true,
        "readDir": true
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true
      },
      "http": {
        "all": true,
        "request": true
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Jarvis",
        "url": "index.html",
        "fullscreen": true,
        "resizable": false,
        "focus": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
